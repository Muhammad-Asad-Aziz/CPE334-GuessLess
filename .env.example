# Mode
NODE_ENV=development

# HTTP Port
PORT=8080

# Database Password (used by docker-compose.yml)
DB_PASSWORD=change-me-db-password

# PostgreSQL Connection Strings
DATABASE_URL=postgresql://survey:change-me-db-password@localhost:5432/survey
TEST_DATABASE_URL=postgresql://survey:change-me-db-password@localhost:5432/survey_test

# JWT Authentication (at least 32 characters, lifetime <= 60 minutes)
JWT_SECRET=change-me-use-a-long-random-value-min-32-chars
JWT_EXPIRES_MINUTES=60

# Password Hashing (production >= 10, default 12; test profile uses 4)
BCRYPT_COST=12

# Privacy & Throttling
ANON_MIN_RESPONSES=5
LOGIN_RATE_MAX_FAILED=10
LOGIN_RATE_WINDOW_SECONDS=60

# Seed Account Password
SEED_PASSWORD=change-me-seed-password

# Observability & Versioning
APP_VERSION=dev
LOG_LEVEL=info

